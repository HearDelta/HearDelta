<UserControl x:Class="HearDelta.App.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:HearDelta.App.Localization"
             xmlns:controls="clr-namespace:HearDelta.App.Controls">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- ============ 1 · Einrichten ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="40,28,40,36" MaxWidth="860" HorizontalAlignment="Left">
                <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" />
                <TextBlock Text="{x:Static l:Strings.Shell_Practice}" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
                <TextBlock Text="{x:Static l:Strings.Practice_Intro}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,20" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Practice_EarAndList}" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{x:Static l:Strings.Practice_Ear}" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource EarSegmented}" ItemsSource="{Binding EarOptions}" SelectedItem="{Binding SelectedEar}" AutomationProperties.Name="{x:Static l:Strings.Practice_Ear}" Margin="0,0,0,14" />
                        <TextBlock Text="{x:Static l:Strings.Practice_List}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static l:Strings.Practice_List}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Practice_Audio}" Style="{StaticResource SectionHeading}" />
                        <Border Style="{StaticResource WarningBox}" Margin="0,0,0,10" Visibility="{Binding HasNoProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{x:Static l:Strings.Test_NoProfileWarning}" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <TextBlock Text="{x:Static l:Strings.Test_Profile}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="{x:Static l:Strings.Test_Profile}" Margin="0,0,0,14" />
                        <TextBlock Text="{x:Static l:Strings.Practice_Volume}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PracticeVolumeText}" FontWeight="SemiBold" Width="90" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider Minimum="{Binding PracticeVolumeMinimumDb}" Maximum="{Binding PracticeVolumeMaximumDb}" Value="{Binding PracticeVolumeDb, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="{x:Static l:Strings.Practice_VolumeName}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <CheckBox Content="{x:Static l:Strings.Practice_Confirm}" IsChecked="{Binding SetupConfirmed}" />
                </Border>

                <Button Content="{x:Static l:Strings.Practice_Start}" Style="{StaticResource PrimaryButton}" Command="{Binding StartPracticeCommand}" IsEnabled="{Binding CanStartPractice}" HorizontalAlignment="Left" MinWidth="260" MinHeight="44" />

                <Expander Header="{x:Static l:Strings.Practice_Hints}" Style="{StaticResource HintsExpander}">
                    <TextBlock Margin="4,10,0,0" Text="{x:Static l:Strings.Practice_HintsText}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 2 · Aktive Übung ============ -->
        <Grid Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource TestBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Practice_Abort}" Command="{Binding AbortPracticeCommand}" />
                    <Button DockPanel.Dock="Right" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding CanPause}" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0" ToolTip="{x:Static l:Strings.Practice_VolumeTooltip}">
                        <TextBlock Text="{x:Static l:Strings.Practice_VolumeShort}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Minimum="{Binding PracticeVolumeMinimumDb}" Maximum="{Binding PracticeVolumeMaximumDb}" Value="{Binding PracticeVolumeDb, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="140" VerticalAlignment="Center" AutomationProperties.Name="{x:Static l:Strings.Practice_VolumeName}" />
                        <TextBlock Text="{Binding PracticeVolumeText}" FontSize="13" Width="70" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding SelectedEar.Label}" /></Border>
                        <TextBlock Text="{Binding SelectedList.Label}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="240" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" BorderThickness="0" Background="{StaticResource BorderBrush}" Foreground="{StaticResource AccentBrush}" />
            <StackPanel Grid.Row="2" VerticalAlignment="Center" MaxWidth="680" Margin="40,0">
                <TextBlock Text="{Binding CurrentPrompt}" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,24" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding SubmitButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitResponseCommand}" IsEnabled="{Binding CanSubmitResponse}" IsDefault="True" Margin="12,0,0,0" MinWidth="200" />
                    <TextBox Text="{Binding EnteredResponse, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAwaitingResponse}" FontSize="26" Padding="14" HorizontalContentAlignment="Center" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" AutomationProperties.Name="{x:Static l:Strings.Practice_Answer}" />
                </DockPanel>
                <Border Style="{StaticResource Badge}" Tag="{Binding FeedbackTone}" HorizontalAlignment="Stretch" CornerRadius="10" Padding="20,14" Margin="0,20,0,0" Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FeedbackTitle}" FontSize="20" />
                        <TextBlock Text="{Binding FeedbackText}" FontSize="15" FontWeight="Normal" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="{x:Static l:Strings.Practice_Next}" Style="{StaticResource PrimaryButton}" Command="{Binding ContinuePracticeCommand}" IsEnabled="{Binding CanContinuePractice}" MinWidth="220" MinHeight="44" Margin="0,0,10,0" />
                    <Button Content="{x:Static l:Strings.Practice_Replay}" Command="{Binding ReplayStimulusCommand}" MinWidth="220" MinHeight="44" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{x:Static l:Strings.Practice_FeedbackNote}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" Margin="0,0,0,16" />
        </Grid>

        <!-- ============ 3 · Abschluss ============ -->
        <StackPanel Margin="40,28,40,36" MaxWidth="860" HorizontalAlignment="Left" Visibility="{Binding IsResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" />
            <TextBlock Text="{Binding ResultsTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding ResultsDescription}" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
            <TextBlock Text="{x:Static l:Strings.Practice_ResultNote}" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,22" />
            <Button Content="{x:Static l:Strings.Practice_New}" Style="{StaticResource PrimaryButton}" Command="{Binding NewPracticeCommand}" MinWidth="220" MinHeight="44" HorizontalAlignment="Left" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</UserControl>
