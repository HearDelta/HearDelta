<UserControl x:Class="HearDelta.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:controls="clr-namespace:HearDelta.App.Controls">
    <UserControl.Resources>
        <!-- Eine Seite der Gegenüberstellung -->
        <DataTemplate x:Key="ComparisonCard">
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding EarText}" /></Border>
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding ComparisonSubtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HearingAidText, StringFormat='Hörgerät: {0}'}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Comment}" Style="{StaticResource Caption}" FontSize="13" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasComment, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Height="14" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ohne Hörgerät" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WithoutAidBrush}" />
                            <TextBlock Text="{Binding WithoutEstimateText}" FontSize="15" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Mit Hörgerät" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" />
                            <TextBlock Text="{Binding WithEstimateText}" FontSize="15" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource WithAidSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding DifferenceCaption}" FontSize="12" Foreground="{StaticResource WithAidBrush}" />
                            <TextBlock Text="{Binding DifferenceEstimateText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Kopf mit Umschalter Worttests / Hörschwellentests -->
        <StackPanel Margin="40,28,40,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Aktualisieren" Command="{Binding ReloadAllCommand}" VerticalAlignment="Center" />
                <TextBlock Text="Verlauf und Vergleich" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <ListBox Style="{StaticResource Segmented}" DisplayMemberPath="" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,14,0,0" AutomationProperties.Name="Testart">
                <sys:String>Worttests</sys:String>
                <sys:String>Hörschwellentests</sys:String>
            </ListBox>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
            </TabControl.ItemContainerStyle>

            <!-- ============ Worttests ============ -->
            <TabItem Header="Worttests">
                <Grid Margin="40,0,40,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="180" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <!-- Filter -->
                    <StackPanel Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResultCountText}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                                <Button Content="Filter zurücksetzen" Style="{StaticResource LinkButton}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" Command="{Binding ResetFiltersCommand}"
                                        Visibility="{Binding HasAnyFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <WrapPanel>
                                <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding EarFilters}" SelectedItem="{Binding SelectedEarFilter}" AutomationProperties.Name="Ohr" Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding MaterialFilters}" SelectedItem="{Binding SelectedMaterialFilter}" DisplayMemberPath="Label" MinWidth="190" AutomationProperties.Name="Material" />
                            </WrapPanel>
                        </DockPanel>
                        <Expander Header="{Binding MoreFiltersHeader}" Style="{StaticResource HintsExpander}" Margin="0,10,0,0">
                            <Grid Margin="4,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="Hörgerät" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding DeviceFilters}" SelectedItem="{Binding SelectedDeviceFilter}" DisplayMemberPath="Label" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Zeitraum" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding PeriodFilters}" SelectedItem="{Binding SelectedPeriodFilter}" DisplayMemberPath="Label" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Status" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding CompletionFilters}" SelectedItem="{Binding SelectedCompletionFilter}" DisplayMemberPath="Label" /></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Text="Hörumgebung" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding EnvironmentFilters}" SelectedItem="{Binding SelectedEnvironmentFilter}" DisplayMemberPath="Label" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"><TextBlock Text="Suche in Name, Kommentar, Hörgerät, Messprofil und Material" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Suche" /></StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <!-- Tabelle -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelectForComparison}"
                                                      HorizontalAlignment="Center" ToolTip="{Binding ComparisonAvailabilityText}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding StartedAtText, StringFormat='Worttest vom {0} für Vergleich auswählen'}"
                                                      AutomationProperties.AutomationId="{Binding Id, StringFormat='WordTestCompare_{0}'}" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding StartedAtText}" Width="140" />
                                    <DataGridTemplateColumn Header="Ohr" Width="84">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Badge}" Tag="{Binding EarTone}"><TextBlock Text="{Binding EarText}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Material und Umgebung" Binding="{Binding MaterialEnvironmentText}" Width="1.4*" />
                                    <DataGridTemplateColumn Header="Name" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Comment}" ToolTipService.IsEnabled="{Binding HasComment}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Comment}" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasComment, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Hörgerät" Binding="{Binding HearingAidText}" Width="1*" />
                                    <DataGridTextColumn Header="Ohne → mit HG" Binding="{Binding ScoreDisplayText}" Width="130" />
                                    <DataGridTemplateColumn Header="Differenz" Width="96">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <TextBlock Text="{Binding DifferenceText}" FontWeight="SemiBold" Foreground="{Binding DifferenceTone, Converter={StaticResource ToneForeground}}" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Status" Width="136">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Badge}" Tag="{Binding StatusTone}"><TextBlock Text="{Binding StatusText}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="250">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Bearbeiten" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,12,0"
                                                        Command="{Binding DataContext.EditWordTestAnnotationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        ToolTip="Name und Kommentar bearbeiten" AutomationProperties.Name="{Binding StartedAtText, StringFormat='Name und Kommentar des Worttests vom {0} bearbeiten'}" />
                                                <Button Content="Löschen" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" FontSize="13" Margin="0,0,12,0"
                                                        Command="{Binding DataContext.DeleteWordTestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        ToolTip="Worttest nach Rückfrage löschen" AutomationProperties.Name="{Binding StartedAtText, StringFormat='Worttest vom {0} löschen'}" />
                                                <Button Content="Öffnen →" Style="{StaticResource LinkButton}" FontSize="13"
                                                        Command="{Binding DataContext.ShowResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanShowResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="{Binding HardwareText}" />
                                            </StackPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Keine Messung entspricht den gewählten Filtern." FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasFilteredSessions}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Vergleichshinweis -->
                    <DockPanel Grid.Row="2" Margin="2,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Auswahl aufheben" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding ClearComparisonCommand}" VerticalAlignment="Center"
                                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button DockPanel.Dock="Right" Content="Vergleich drucken" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding PrintWordComparisonCommand}" VerticalAlignment="Center" Margin="0,0,16,0"
                                ToolTip="Gegenüberstellung drucken oder als PDF speichern" Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectionHintText}" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Vergleich -->
                    <ScrollViewer Grid.Row="3" MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="8" Padding="16,10" Margin="0,0,0,10" Visibility="{Binding HasDirectComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ComparisonAssessmentText}" Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                            <Border Style="{StaticResource WarningBox}" Margin="0,0,0,10" Visibility="{Binding HasComparisonWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel><TextBlock Text="Nicht direkt vergleichbar" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4" /><TextBlock Text="{Binding ComparisonAssessmentText}" /></StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding FirstComparison}" ContentTemplate="{StaticResource ComparisonCard}" />
                                <ContentControl Grid.Column="2" Content="{Binding SecondComparison}" ContentTemplate="{StaticResource ComparisonCard}" />
                            </Grid>
                            <TextBlock Text="Prozentwerte: 95-%-Intervalle der jeweils 25 Antworten. Adaptive Zahlentests: Schwelle für 50 % richtig mit Streuung der gemittelten Werte. Beides ist eine deskriptive Orientierung, kein Nachweis eines Geräteunterschieds." TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="13" Margin="2,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ Hörschwellentests ============ -->
            <TabItem Header="Hörschwellentests">
                <Grid Margin="40,0,40,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Margin="2,0,0,10" Visibility="{Binding HasHearingThresholdTests, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button DockPanel.Dock="Right" Content="Auswahl aufheben" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding ClearThresholdComparisonCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding HasThresholdComparisonSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding ThresholdComparisonHint}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding HearingThresholdTests}" SelectedItem="{Binding SelectedThresholdTest}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasHearingThresholdTests, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12"><ContentPresenter /></Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Tag="{Binding StatusTone}"><TextBlock Text="{Binding StatusText}" /></Border>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsComparisonSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      ToolTip="Für den Kurvenvergleich auswählen" AutomationProperties.Name="{Binding StartedAtText, StringFormat='Hörschwellentest vom {0} vergleichen'}"
                                                      AutomationProperties.AutomationId="{Binding Id, StringFormat='ThresholdTestCompare_{0}'}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding StartedAtText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,6,0"><TextBlock Text="{Binding EarText}" /></Border>
                                            <Border Style="{StaticResource Badge}" Tag="{Binding ConditionTone}"><TextBlock Text="{Binding ConditionText}" /></Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding HasNoHearingThresholdTests, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Noch keine Hörschwellentests" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="Abgeschlossene und abgebrochene Tests erscheinen nach ihrer ersten Speicherung hier." Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2" Visibility="{Binding IsThresholdSingleView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,6,0,0">
                                <Button Content="Drucken" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,14,0"
                                        Command="{Binding PrintSelectedThresholdCommand}" ToolTip="Diagramm und Ergebnis drucken oder als PDF speichern" />
                                <Button Content="Bearbeiten" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,14,0"
                                        Command="{Binding EditSelectedThresholdAnnotationCommand}" ToolTip="Name und Kommentar bearbeiten" />
                                <Button Content="Test löschen" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" FontSize="13"
                                        Command="{Binding DeleteSelectedThresholdTestCommand}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedThresholdTest.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedThresholdTitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedThresholdTest.Comment}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding SelectedThresholdTest.HasComment, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Style="{StaticResource Badge}" Tag="{Binding SelectedThresholdTest.EarTone}" Margin="0,0,6,0"><TextBlock Text="{Binding SelectedThresholdTest.EarText}" /></Border>
                                    <Border Style="{StaticResource Badge}" Tag="{Binding SelectedThresholdTest.ConditionTone}" Margin="0,0,6,0"><TextBlock Text="{Binding SelectedThresholdTest.ConditionText}" /></Border>
                                    <Border Style="{StaticResource Badge}" Tag="{Binding SelectedThresholdTest.StatusTone}" Margin="0,0,10,0"><TextBlock Text="{Binding SelectedThresholdTest.StatusText}" /></Border>
                                    <TextBlock Text="{Binding SelectedThresholdTest.ResultText}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,16,0,14">
                            <controls:HearingThresholdChart ItemsSource="{Binding SelectedThresholdResults}"
                                                            Ear="{Binding SelectedThresholdTest.Ear}"
                                                            MaximumAttenuationDbfs="{Binding SelectedThresholdTest.MaximumAttenuationDbfs}"
                                                            MinHeight="340"
                                                            AutomationProperties.Name="Frequenzdiagramm des ausgewählten Hörschwellentests" />
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Messaufbau" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SelectedThresholdHardwareText}" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vertäubung und Protokoll" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SelectedThresholdConditionText}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedThresholdProtocolText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Kurvenvergleich -->
                    <Grid Grid.Column="2" Visibility="{Binding HasThresholdComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="300" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Vergleich drucken" Style="{StaticResource LinkButton}" FontSize="13" VerticalAlignment="Center"
                                        Command="{Binding PrintThresholdComparisonCommand}" ToolTip="Vergleichsdiagramm und Tabelle drucken oder als PDF speichern" />
                                <TextBlock Text="Vergleich der Hörschwellen" FontSize="20" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Text="Ohr als Symbol wie im Audiogramm: X links, O rechts. Farben unterscheiden die Tests." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource WarningBox}" Margin="0,12,0,0" Visibility="{Binding HasThresholdComparisonWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel><TextBlock Text="Unterschiedlicher Messaufbau" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4" /><TextBlock Text="{Binding ThresholdComparisonWarningText}" /></StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,14">
                            <controls:HearingThresholdChart Series="{Binding ThresholdComparisonSeries}"
                                                            MaximumAttenuationDbfs="{Binding ThresholdComparisonMaximumDbfs}"
                                                            MinHeight="300"
                                                            AutomationProperties.Name="Vergleich der Hörschwellen" />
                        </Border>
                        <StackPanel Grid.Row="3" Visibility="{Binding HasThresholdComparisonTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="2,0,0,6">
                                <Run Text="Test " /><Run Text="{Binding ThresholdComparisonFirstLabel, Mode=OneWay}" /><Run Text="     Test " /><Run Text="{Binding ThresholdComparisonSecondLabel, Mode=OneWay}" />
                            </TextBlock>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <DataGrid ItemsSource="{Binding ThresholdComparisonRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="260" MinRowHeight="32">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Frequenz" Binding="{Binding FrequencyText}" Width="110" />
                                        <DataGridTextColumn Header="Test 1" Binding="{Binding FirstText}" Width="*" />
                                        <DataGridTextColumn Header="Test 2" Binding="{Binding SecondText}" Width="*" />
                                        <DataGridTemplateColumn Header="Test 2 gegenüber Test 1" Width="1.3*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBlock Text="{Binding DifferenceText}" FontWeight="SemiBold" Foreground="{Binding DifferenceTone, Converter={StaticResource ToneForeground}}" />
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <TextBlock Text="„Besser“ heißt: Test 2 hat einen leiseren Ton gehört. Digitale dBFS-Werte, keine dB SPL." Style="{StaticResource Caption}" FontSize="12" Margin="2,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</UserControl>
