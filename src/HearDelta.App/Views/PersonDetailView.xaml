<UserControl x:Class="HearDelta.App.Views.PersonDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:HearDelta.App.Localization">
    <ScrollViewer Background="{StaticResource PageBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,32" MaxWidth="1040" HorizontalAlignment="Left">

            <!-- Kopf -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentBrush}" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,2,0,0" />
                    <ItemsControl ItemsSource="{Binding HearingAids}" Margin="0,8,0,0" Visibility="{Binding HasHearingAids, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,6,0"><TextBlock Text="{Binding Label}" /></Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Empfohlener Ablauf -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="{x:Static l:Strings.Overview_RecommendedFlow}" Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center" />
                <ListBox Style="{StaticResource EarSegmented}" ItemsSource="{Binding PlanEarOptions}" SelectedItem="{Binding PlanEar}" HorizontalAlignment="Right"
                         AutomationProperties.Name="{x:Static l:Strings.Overview_PlanEar}" />
            </Grid>
            <TextBlock Text="{Binding PlanHint}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding PlanSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecommended}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding StartButtonText}" VerticalAlignment="Center" MinWidth="120" Margin="16,0,0,0"
                                            Command="{Binding DataContext.StartPlanStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Title, StringFormat={x:Static l:Strings.Common_StartItem}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="White" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PageBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRecommended}" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecommended}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <WrapPanel Margin="2,0,0,28">
                <TextBlock Text="{x:Static l:Strings.Overview_FreeChoice}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="{x:Static l:Strings.Shell_WordTest}" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,16,0" Command="{Binding DataContext.ShowMeasurementCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="{x:Static l:Strings.Shell_HearingThreshold}" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,16,0" Command="{Binding DataContext.ShowHearingThresholdCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="{x:Static l:Strings.Overview_PracticeLink}" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding DataContext.ShowPracticeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </WrapPanel>

            <!-- Letzte Messungen -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="{x:Static l:Strings.Overview_Recent}" Style="{StaticResource SectionHeading}" Margin="0" />
                <Button Content="{x:Static l:Strings.Overview_ShowAll}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasRecentMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding RecentMeasurements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource EarDot}" Tag="{Binding EarTone}">
                                        <TextBlock Text="{Binding EarLetter}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="4" Text="{Binding DifferenceText}" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                               Visibility="{Binding HasDifference, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Border Grid.Column="5" Style="{StaticResource Badge}" Tag="{Binding StatusTone}" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusText}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding HasNoRecentMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{x:Static l:Strings.Overview_NoMeasurementsTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static l:Strings.Overview_NoMeasurementsText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Legende -->
            <WrapPanel Margin="2,12,0,0" Visibility="{Binding HasRecentMeasurements, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,18,0"><Run Text="●" Foreground="{StaticResource EarRightBrush}" /> <Run Text="{x:Static l:Strings.Overview_LegendRightEar}" /></TextBlock>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,18,0"><Run Text="●" Foreground="{StaticResource EarLeftBrush}" /> <Run Text="{x:Static l:Strings.Overview_LegendLeftEar}" /></TextBlock>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,18,0"><Run Text="●" Foreground="{StaticResource SuccessBrush}" /> <Run Text="{x:Static l:Strings.Overview_LegendCompleted}" /></TextBlock>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,18,0"><Run Text="●" Foreground="{StaticResource WarningBrush}" /> <Run Text="{x:Static l:Strings.Overview_LegendAborted}" /></TextBlock>
                <TextBlock Style="{StaticResource Caption}"><Run Text="{x:Static l:Strings.Overview_LegendDifference}" Foreground="{StaticResource WithAidBrush}" FontWeight="SemiBold" /> <Run Text="{x:Static l:Strings.Overview_LegendDifferenceText}" /></TextBlock>
            </WrapPanel>

            <!-- Notizen -->
            <StackPanel Margin="0,28,0,0" Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{x:Static l:Strings.Overview_Notes}" Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}"><TextBlock Text="{Binding Notes}" FontSize="15" /></Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
