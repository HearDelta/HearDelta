<UserControl x:Class="HearDelta.App.Views.HearingThresholdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HearDelta.App.Controls"
             xmlns:l="clr-namespace:HearDelta.App.Localization">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- ============ 1 · Einrichten ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="40,28,40,36" MaxWidth="860" HorizontalAlignment="Left">
                <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" />
                <TextBlock Text="{x:Static l:Strings.Shell_HearingThreshold}" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
                <TextBlock Text="{x:Static l:Strings.Threshold_Intro}" Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Threshold_EarAndMasking}" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{x:Static l:Strings.Threshold_TestedEar}" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource EarSegmented}" ItemsSource="{Binding EarOptions}" SelectedItem="{Binding SelectedEar}" AutomationProperties.Name="{x:Static l:Strings.Threshold_TestedEar}" Margin="0,0,0,14" />
                        <CheckBox IsChecked="{Binding IsMaskingEnabled}" AutomationProperties.Name="{x:Static l:Strings.Threshold_MaskOtherEar}">
                            <TextBlock><Run Text="{x:Static l:Strings.Threshold_MaskOtherEar}" /><Run Text=" · " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding MaskedEarText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                        </CheckBox>
                        <StackPanel Margin="26,12,0,0" Visibility="{Binding IsMaskingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MaskingLevelText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="150" />
                                <TextBlock Text="{x:Static l:Strings.Threshold_MaskingLevel}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Slider Minimum="{Binding MinimumMaskingLevelDbfs, Mode=OneWay}" Maximum="{Binding MaximumMaskingLevelDbfs, Mode=OneWay}" Value="{Binding MaskingLevelDbfs}"
                                    SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{x:Static l:Strings.Threshold_MaskingLevel}" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding MaskingPreviewButtonText}" Command="{Binding PlayMaskingPreviewCommand}" MinWidth="170" Margin="0,0,12,0" />
                                <TextBlock Text="{x:Static l:Strings.Threshold_MaskingPreviewHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Threshold_MaskingNoiseHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Name und Kommentar -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Annotation_Section}" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{x:Static l:Strings.Annotation_Name}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Annotation.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="{x:Static l:Strings.Annotation_Name}" />
                        <TextBlock Text="{x:Static l:Strings.Threshold_AnnotationHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="{x:Static l:Strings.Annotation_Comment}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Annotation.Comment, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{x:Static l:Strings.Annotation_CommentName}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Threshold_SequenceAndAudio}" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{x:Static l:Strings.Threshold_OrderAfter500}" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding OrderOptions}" SelectedItem="{Binding SelectedOrder}" AutomationProperties.Name="{x:Static l:Strings.Threshold_Order}" Margin="0,0,0,14" />
                        <Border Style="{StaticResource WarningBox}" Margin="0,0,0,10" Visibility="{Binding HasNoProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{x:Static l:Strings.Test_NoProfileWarning}" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StartLevelText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="100" />
                            <TextBlock Text="{x:Static l:Strings.Threshold_StartVolume}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Slider Minimum="{Binding MinimumStartLevelDbfs, Mode=OneWay}" Maximum="{Binding MaximumStartLevelDbfs, Mode=OneWay}" Value="{Binding StartLevelDbfs}"
                                SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{x:Static l:Strings.Threshold_StartVolume}" Margin="0,4,0,4" />
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="{Binding DefaultStartLevelText}" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding ResetStartLevelCommand}"
                                    IsEnabled="{Binding IsStartLevelRaised}" ToolTip="{x:Static l:Strings.Threshold_ResetStartVolume}" Margin="12,0,0,0" />
                            <TextBlock Text="{x:Static l:Strings.Threshold_StartVolumeHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{x:Static l:Strings.Test_Profile}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="{x:Static l:Strings.Test_Profile}" />
                        <TextBlock FontSize="13" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{x:Static l:Strings.Threshold_ProfileRamp}">
                                    <Binding Path="SelectedProfile.EndpointName" />
                                    <Binding Path="StartAttenuationText" />
                                    <Binding Path="MaximumAttenuationText" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Test_ConfirmBeforeStart}" Style="{StaticResource SectionHeading}" />
                        <CheckBox Content="{x:Static l:Strings.Test_ConfirmEar}" IsChecked="{Binding CorrectEarConfirmed}" Margin="0,0,0,12" />
                        <CheckBox Content="{x:Static l:Strings.Test_ConfirmFit}" IsChecked="{Binding HeadphoneFitConfirmed}" />
                    </StackPanel>
                </Border>

                <Button Content="{x:Static l:Strings.Threshold_Start}" Style="{StaticResource PrimaryButton}" Command="{Binding StartTestCommand}" IsEnabled="{Binding CanStartTest}" HorizontalAlignment="Left" MinWidth="280" MinHeight="44" />

                <Expander Header="{x:Static l:Strings.Test_Hints}" Style="{StaticResource HintsExpander}">
                    <StackPanel Margin="4,10,0,0">
                        <TextBlock Text="{Binding RampDescription}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding MaskingDescription}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{x:Static l:Strings.Threshold_LevelsNote}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 2 · Aktiver Test ============ -->
        <Grid Visibility="{Binding IsActiveTest, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource TestBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Test_Abort}" Command="{Binding AbortTestCommand}" />
                    <Button DockPanel.Dock="Right" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding CanPause}" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding SelectedEar.Label}" /></Border>
                        <Border Style="{StaticResource Badge}" Tag="{Binding SessionConditionTone}" Margin="0,0,8,0"><TextBlock Text="{Binding SessionConditionText}" /></Border>
                        <TextBlock Text="{Binding TestPhaseTitle}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" BorderThickness="0" Background="{StaticResource BorderBrush}" Foreground="{StaticResource AccentBrush}" />
            <StackPanel Grid.Row="2" VerticalAlignment="Center" MaxWidth="760" Margin="40,0">
                <TextBlock Text="{x:Static l:Strings.Threshold_AsSoonAsHeard}" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,26" />
                <Button Content="{x:Static l:Strings.Threshold_IHearIt}" Command="{Binding HeardCommand}" IsEnabled="{Binding CanReportHeard}" Style="{StaticResource PrimaryButton}" FontSize="28" MinWidth="440" MinHeight="140" HorizontalAlignment="Center" />
                <Button Content="{x:Static l:Strings.Threshold_RepeatLast}" Command="{Binding RepeatLastMeasurementCommand}" IsEnabled="{Binding CanRepeatLastMeasurement}" Margin="0,18,0,0" MinWidth="280" HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{Binding PresentationDisclosure}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" Margin="60,0,60,16" />
        </Grid>

        <!-- ============ 3 · Ergebnis ============ -->
        <Grid Visibility="{Binding IsResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="40,28,40,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding ResultsTitle}" Style="{StaticResource PageTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding SelectedEar.Label}" /></Border>
                        <Border Style="{StaticResource Badge}" Tag="{Binding SessionConditionTone}" Margin="0,0,12,0"><TextBlock Text="{Binding SessionConditionText}" /></Border>
                        <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,16" Text="{Binding CenterResultText, StringFormat={x:Static l:Strings.Threshold_ResultNote}}" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
                    <controls:HearingThresholdChart ItemsSource="{Binding Results}"
                                                    Ear="{Binding SelectedEar.Value}"
                                                    MaximumAttenuationDbfs="{Binding ResultMaximumAttenuationDbfs}"
                                                    MinHeight="380"
                                                    AutomationProperties.Name="{x:Static l:Strings.Threshold_ChartName}" />
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="{x:Static l:Strings.Threshold_New}" Style="{StaticResource PrimaryButton}" Command="{Binding NewTestCommand}" MinWidth="260" MinHeight="44" Margin="0,0,12,0" />
                    <Button Content="{x:Static l:Strings.Threshold_RepeatLast}" Command="{Binding RepeatLastMeasurementCommand}" IsEnabled="{Binding CanRepeatLastMeasurement}" MinWidth="240" MinHeight="44" Margin="0,0,12,0" />
                    <Button Content="{x:Static l:Strings.Test_Print}" Command="{Binding PrintResultCommand}" MinWidth="140" MinHeight="44" ToolTip="{x:Static l:Strings.Test_PrintTooltip}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</UserControl>
