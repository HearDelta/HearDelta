<UserControl x:Class="HearDelta.App.Views.HearingThresholdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HearDelta.App.Controls">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- ============ 1 · Einrichten ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="40,28,40,36" MaxWidth="860" HorizontalAlignment="Left">
                <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" />
                <TextBlock Text="Hörschwelle" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
                <TextBlock Text="14 Sinustöne von 62,5 Hz bis 10 kHz, beginnend mit 500 Hz. Jeder Ton wird leise gestartet und schrittweise lauter. Gemessen wird ohne Hörgerät." Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Ohr und Vertäubung" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Geprüftes Ohr" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource EarSegmented}" ItemsSource="{Binding EarOptions}" SelectedItem="{Binding SelectedEar}" AutomationProperties.Name="Geprüftes Ohr" Margin="0,0,0,14" />
                        <CheckBox IsChecked="{Binding IsMaskingEnabled}" AutomationProperties.Name="Gegenohr vertäuben">
                            <TextBlock><Run Text="Gegenohr vertäuben" /><Run Text=" · " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding MaskedEarText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                        </CheckBox>
                        <StackPanel Margin="26,12,0,0" Visibility="{Binding IsMaskingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MaskingLevelText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="150" />
                                <TextBlock Text="Pegel des Vertäubungsrauschens" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Slider Minimum="{Binding MinimumMaskingLevelDbfs, Mode=OneWay}" Maximum="{Binding MaximumMaskingLevelDbfs, Mode=OneWay}" Value="{Binding MaskingLevelDbfs}"
                                    SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Pegel des Vertäubungsrauschens" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding MaskingPreviewButtonText}" Command="{Binding PlayMaskingPreviewCommand}" MinWidth="170" Margin="0,0,12,0" />
                                <TextBlock Text="Hörprobe 3 s um 500 Hz auf dem Gegenohr" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Terzbreites Schmalbandrauschen um die jeweilige Prüffrequenz mit festem Pegel. Es soll deutlich hörbar, aber nicht unangenehm sein." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Name und Kommentar -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Name und Kommentar" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Name der Messung" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Annotation.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Name der Messung" />
                        <TextBlock Text="Vorgabe ist „Hörschwelle“ bzw. „Hörschwelle mit Vertäubung“. Name und Kommentar lassen sich später im Verlauf ändern." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="Kommentar, Einstellungen (optional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Annotation.Comment, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Kommentar zur Messung" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Ablauf und Audio" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Reihenfolge nach 500 Hz" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding OrderOptions}" SelectedItem="{Binding SelectedOrder}" AutomationProperties.Name="Reihenfolge" Margin="0,0,0,14" />
                        <Border Style="{StaticResource WarningBox}" Margin="0,0,0,10" Visibility="{Binding HasNoProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Noch kein Messprofil vorhanden. Lege es unter „Audio und Kopfhörer“ an." Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StartLevelText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="100" />
                            <TextBlock Text="Startlautstärke" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Slider Minimum="{Binding MinimumStartLevelDbfs, Mode=OneWay}" Maximum="{Binding MaximumStartLevelDbfs, Mode=OneWay}" Value="{Binding StartLevelDbfs}"
                                SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Startlautstärke" Margin="0,4,0,4" />
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="{Binding DefaultStartLevelText}" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding ResetStartLevelCommand}"
                                    IsEnabled="{Binding IsStartLevelRaised}" ToolTip="Startlautstärke auf die Vorgabe zurücksetzen" Margin="12,0,0,0" />
                            <TextBlock Text="Der erste Ton (500 Hz) beginnt mit dieser Lautstärke, kein Folgeton beginnt leiser. Bei starker Schwerhörigkeit lauter starten, aber deutlich unter der erwarteten Hörschwelle (etwa 10–15 dB)." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="Messprofil" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Messprofil" />
                        <TextBlock FontSize="13" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding SelectedProfile.EndpointName, Mode=OneWay}" /><Run Text=" · Pegelrampe " /><Run Text="{Binding StartAttenuationText, Mode=OneWay}" /><Run Text=" bis " /><Run Text="{Binding MaximumAttenuationText, Mode=OneWay}" /><Run Text=" dBFS" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Vor dem Start bestätigen" Style="{StaticResource SectionHeading}" />
                        <CheckBox Content="Die angezeigte Hörseite und der Kopfhörerkanal stimmen." IsChecked="{Binding CorrectEarConfirmed}" Margin="0,0,0,12" />
                        <CheckBox Content="Der Kopfhörer sitzt korrekt und ohne Kontakt oder Rückkopplung." IsChecked="{Binding HeadphoneFitConfirmed}" />
                    </StackPanel>
                </Border>

                <Button Content="Hörschwellentest starten" Style="{StaticResource PrimaryButton}" Command="{Binding StartTestCommand}" IsEnabled="{Binding CanStartTest}" HorizontalAlignment="Left" MinWidth="280" MinHeight="44" />

                <Expander Header="Hinweise zur Messung" Style="{StaticResource HintsExpander}">
                    <StackPanel Margin="4,10,0,0">
                        <TextBlock Text="{Binding RampDescription}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding MaskingDescription}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="Die Werte sind digitale dBFS-Pegel und ohne Kupplerkalibrierung keine dB SPL. Der Test ist kein klinisches Audiogramm." />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 2 · Aktiver Test ============ -->
        <Grid Visibility="{Binding IsActiveTest, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource TestBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Test abbrechen" Command="{Binding AbortTestCommand}" />
                    <Button DockPanel.Dock="Right" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding CanPause}" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding SelectedEar.Label}" /></Border>
                        <Border Style="{StaticResource Badge}" Tag="{Binding SessionConditionTone}" Margin="0,0,8,0"><TextBlock Text="{Binding SessionConditionText}" /></Border>
                        <TextBlock Text="{Binding TestPhaseTitle}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" BorderThickness="0" Background="{StaticResource BorderBrush}" Foreground="{StaticResource AccentBrush}" />
            <StackPanel Grid.Row="2" VerticalAlignment="Center" MaxWidth="760" Margin="40,0">
                <TextBlock Text="Sobald Sie etwas hören:" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,26" />
                <Button Content="ICH HÖRE DEN TON" Command="{Binding HeardCommand}" IsEnabled="{Binding CanReportHeard}" Style="{StaticResource PrimaryButton}" FontSize="28" MinWidth="440" MinHeight="140" HorizontalAlignment="Center" />
                <Button Content="Letzte Messung wiederholen" Command="{Binding RepeatLastMeasurementCommand}" IsEnabled="{Binding CanRepeatLastMeasurement}" Margin="0,18,0,0" MinWidth="280" HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{Binding PresentationDisclosure}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" Margin="60,0,60,16" />
        </Grid>

        <!-- ============ 3 · Ergebnis ============ -->
        <Grid Visibility="{Binding IsResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="40,28,40,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding ResultsTitle}" Style="{StaticResource PageTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding SelectedEar.Label}" /></Border>
                        <Border Style="{StaticResource Badge}" Tag="{Binding SessionConditionTone}" Margin="0,0,12,0"><TextBlock Text="{Binding SessionConditionText}" /></Border>
                        <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,16"><Run Text="{Binding CenterResultText, Mode=OneWay}" /><Run Text=" · digitale dBFS-Werte, keine dB SPL, kein klinisches Audiogramm" /></TextBlock>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
                    <controls:HearingThresholdChart ItemsSource="{Binding Results}"
                                                    Ear="{Binding SelectedEar.Value}"
                                                    MaximumAttenuationDbfs="{Binding ResultMaximumAttenuationDbfs}"
                                                    MinHeight="380"
                                                    AutomationProperties.Name="Frequenzdiagramm der gemessenen Hörschwellen in dBFS" />
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="Neuer Hörschwellentest" Style="{StaticResource PrimaryButton}" Command="{Binding NewTestCommand}" MinWidth="260" MinHeight="44" Margin="0,0,12,0" />
                    <Button Content="Letzte Messung wiederholen" Command="{Binding RepeatLastMeasurementCommand}" IsEnabled="{Binding CanRepeatLastMeasurement}" MinWidth="240" MinHeight="44" Margin="0,0,12,0" />
                    <Button Content="Drucken …" Command="{Binding PrintResultCommand}" MinWidth="140" MinHeight="44" ToolTip="Diagramm und Ergebnis drucken oder als PDF speichern" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</UserControl>
