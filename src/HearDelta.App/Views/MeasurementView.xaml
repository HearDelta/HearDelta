<UserControl x:Class="HearDelta.App.Views.MeasurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HearDelta.App.Controls"
             xmlns:l="clr-namespace:HearDelta.App.Localization">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- ============ 1 · Einrichten ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="40,28,40,36" MaxWidth="860" HorizontalAlignment="Left">
                <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" />
                <TextBlock Text="{x:Static l:Strings.Shell_WordTest}" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
                <TextBlock Text="{x:Static l:Strings.Measure_Intro}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,20" />

                <!-- Gewählter Schritt des empfohlenen Ablaufs -->
                <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16" Visibility="{Binding HasPlanStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding PlanStepText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Laufende Messreihe -->
                <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16" Visibility="{Binding HasPreparedSeries, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Measure_DiscardSeries}" Style="{StaticResource LinkButton}" Command="{Binding ClearSeriesCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding SeriesPlanSummary}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Was wird getestet -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Measure_MaterialAndEnvironment}" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{x:Static l:Strings.Measure_Material}" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding MaterialOptions}" SelectedItem="{Binding SelectedMaterialOption}" AutomationProperties.Name="{x:Static l:Strings.Measure_Material}" Margin="0,0,0,14" />
                        <TextBlock Text="{x:Static l:Strings.Measure_Environment}" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding SelectedEnvironment}" AutomationProperties.Name="{x:Static l:Strings.Measure_Environment}" />
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding IsBackgroundNoise, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding SignalToNoiseLabel}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SignalToNoiseRatioDb}" Width="70" HorizontalContentAlignment="Right" AutomationProperties.Name="{x:Static l:Strings.Measure_SnrName}" />
                                <TextBlock Text="dB" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsAdaptiveAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{x:Static l:Strings.Measure_Level}" Style="{StaticResource FieldLabel}" />
                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding LevelModeOptions}" SelectedItem="{Binding SelectedLevelMode}" AutomationProperties.Name="{x:Static l:Strings.Measure_LevelMode}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding LevelModeDescription}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ohr und Hörgerät -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Measure_EarAndAid}" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{x:Static l:Strings.Threshold_TestedEar}" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource EarSegmented}" ItemsSource="{Binding EarOptions}" SelectedItem="{Binding SelectedEar}" AutomationProperties.Name="{x:Static l:Strings.Threshold_TestedEar}" Margin="0,0,0,14" />
                        <TextBlock Text="{x:Static l:Strings.Measure_AidAtEar}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding HearingAidChoices}" SelectedItem="{Binding SelectedHearingAidChoice}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static l:Strings.Measure_Aid}" />
                        <TextBlock Text="{x:Static l:Strings.Measure_AidManageHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <Grid Margin="0,12,0,0" Visibility="{Binding IsManualHearingAid, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{x:Static l:Strings.Common_Manufacturer}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding HearingAidManufacturer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static l:Strings.Common_Manufacturer}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{x:Static l:Strings.Common_Model}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding HearingAidModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static l:Strings.Common_Model}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="{x:Static l:Strings.Measure_ProtocolName}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding HearingAidDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static l:Strings.Measure_ProtocolName}" /></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{x:Static l:Strings.Measure_Program}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding HearingAidProgramName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static l:Strings.Measure_Program}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Name und Kommentar -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Annotation_Section}" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{x:Static l:Strings.Annotation_Name}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Annotation.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="{x:Static l:Strings.Annotation_Name}" />
                        <TextBlock Text="{x:Static l:Strings.Measure_AnnotationHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="{x:Static l:Strings.Annotation_Comment}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Annotation.Comment, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{x:Static l:Strings.Annotation_CommentName}" />
                    </StackPanel>
                </Border>

                <!-- Audio -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Measure_AudioOutput}" Style="{StaticResource SectionHeading}" />
                        <Border Style="{StaticResource WarningBox}" Margin="0,0,0,10" Visibility="{Binding HasNoProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{x:Static l:Strings.Test_NoProfileWarning}" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <TextBlock Text="{x:Static l:Strings.Test_Profile}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="{x:Static l:Strings.Test_Profile}" />
                        <TextBlock FontSize="13" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{x:Static l:Strings.Measure_ProfileLimit}">
                                    <Binding Path="SelectedProfile.EndpointName" />
                                    <Binding Path="SelectedProfile.MaximumVolumeDb" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding PresentationVolumeLabel}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Measure_PlayTestWord}" Command="{Binding PlayTestWordCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PresentationVolumeText}" FontWeight="SemiBold" Width="70" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider Minimum="{Binding PresentationVolumeMinimumDb}" Maximum="{Binding PresentationVolumeMaximumDb}" Value="{Binding PresentationVolumeDb, Mode=TwoWay}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" VerticalAlignment="Center" AutomationProperties.Name="{x:Static l:Strings.Measure_SpeechVolumeName}" />
                        </DockPanel>
                        <TextBlock Text="{Binding LevelSourceText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding HasLevelSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Static l:Strings.Measure_VolumeHint}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Ablauf -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Measure_Sequence}" Style="{StaticResource SectionHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="{x:Static l:Strings.Measure_Sequence}" />
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding IsSeriesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{x:Static l:Strings.Measure_Pairs}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SeriesPairCount, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalContentAlignment="Right" AutomationProperties.Name="{x:Static l:Strings.Measure_PairCount}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Measure_SeriesHint}" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0" Visibility="{Binding IsSeriesMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Button Content="{Binding StartButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding StartMeasurementCommand}" HorizontalAlignment="Left" MinWidth="260" MinHeight="44" />

                <Expander Header="{x:Static l:Strings.Test_Hints}" Style="{StaticResource HintsExpander}">
                    <StackPanel Margin="4,10,0,0">
                        <TextBlock Text="{x:Static l:Strings.Measure_HintsText}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ChanceLevelText}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AiVoiceDisclosure}" Margin="0,0,0,12" />
                        <TextBlock Text="{x:Static l:Strings.Measure_ExposureTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding ExposureCells}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="220" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static l:Strings.Measure_ExposureScope}" Binding="{Binding Scope}" Width="*" />
                                <DataGridTextColumn Header="{x:Static l:Strings.Measure_ExposureId}" Binding="{Binding Key}" Width="1.6*" />
                                <DataGridTextColumn Header="{x:Static l:Strings.Measure_ExposureCount}" Binding="{Binding PresentationCount}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{x:Static l:Strings.Measure_ExposureNote}" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 2a · Block vorbereiten ============ -->
        <Grid Visibility="{Binding IsPreparation, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource TestBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Test_Abort}" Command="{Binding AbortMeasurementCommand}" />
                    <controls:StepIndicator DockPanel.Dock="Right" Step="{Binding StepNumber}" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding EarLabel}" /></Border>
                        <TextBlock Text="{Binding CurrentMaterialLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="60,44" MaxWidth="720" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding BlockTitle}" Style="{StaticResource PageTitle}" FontSize="30" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Tag="{Binding CurrentConditionTone}" HorizontalAlignment="Center" Padding="16,6" Margin="0,14,0,0">
                        <TextBlock Text="{Binding CurrentConditionLabel}" FontSize="18" />
                    </Border>
                    <TextBlock Text="{Binding PreparationInstruction}" FontSize="19" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,28" />
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Test_ConfirmBeforeStart}" Style="{StaticResource SectionHeading}" />
                            <CheckBox Content="{x:Static l:Strings.Test_ConfirmEar}" IsChecked="{Binding CorrectEarConfirmed}" Margin="0,0,0,14" />
                            <CheckBox Content="{x:Static l:Strings.Measure_ConfirmFitAid}" IsChecked="{Binding HeadphoneFitConfirmed}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Static l:Strings.Measure_EachOnce}" TextAlignment="Center" Style="{StaticResource Caption}" FontSize="14" Margin="0,18,0,16" />
                    <Button Content="{x:Static l:Strings.Measure_StartBlock}" Style="{StaticResource PrimaryButton}" Command="{Binding StartBlockCommand}" IsEnabled="{Binding CanStartBlock}" MinWidth="260" MinHeight="46" HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 2b · Aktiver Test ============ -->
        <Grid Visibility="{Binding IsActiveTest, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource TestBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Test_Abort}" Command="{Binding AbortMeasurementCommand}" />
                    <Button DockPanel.Dock="Right" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding CanPause}" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding EarLabel}" /></Border>
                        <Border Style="{StaticResource Badge}" Tag="{Binding CurrentConditionTone}" Margin="0,0,8,0"><TextBlock Text="{Binding CurrentConditionLabel}" /></Border>
                        <TextBlock Text="{Binding CurrentMaterialLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" BorderThickness="0" Background="{StaticResource BorderBrush}" Foreground="{StaticResource AccentBrush}" />
            <StackPanel Grid.Row="2" VerticalAlignment="Center" MaxWidth="980" Margin="40,0">
                <TextBlock Text="{x:Static l:Strings.Practice_WhatDidYouHear}" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,28" />
                <ItemsControl ItemsSource="{Binding ResponseAlternatives}" IsEnabled="{Binding CanAnswer}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding UsesFreeNumericResponse}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}" Style="{StaticResource AnswerButton}"
                                    Command="{Binding DataContext.SelectAnswerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding UsesFreeNumericResponse, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" Width="360">
                    <TextBlock Text="{x:Static l:Strings.Measure_EnterNumber}" FontSize="18" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <TextBox x:Name="NumericAnswerTextBox"
                             Text="{Binding NumericAnswer, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanAnswer}"
                             FontSize="34"
                             FontWeight="SemiBold"
                             HorizontalContentAlignment="Center"
                             MaxLength="3"
                             BorderBrush="{StaticResource AccentBrush}"
                             BorderThickness="2"
                             Loaded="NumericAnswerTextBox_OnLoaded"
                             IsEnabledChanged="NumericAnswerTextBox_OnStateChanged"
                             IsVisibleChanged="NumericAnswerTextBox_OnStateChanged" />
                    <Button Content="{x:Static l:Strings.Measure_SaveAnswer}"
                            Command="{Binding SubmitNumericAnswerCommand}"
                            IsEnabled="{Binding CanSubmitNumericAnswer}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="46"
                            Margin="0,14,0,0" />
                </StackPanel>
                <Button Content="{x:Static l:Strings.Measure_NotUnderstood}" Command="{Binding NotUnderstoodCommand}" IsEnabled="{Binding CanAnswer}" Margin="7,20,7,0" MinWidth="260" MinHeight="46" FontSize="17" HorizontalAlignment="Center" />
                <Button Content="{x:Static l:Strings.Measure_RetryPlayback}" Command="{Binding RetryPlaybackCommand}" Style="{StaticResource PrimaryButton}" Margin="7,16,7,0" MinWidth="280" HorizontalAlignment="Center" Visibility="{Binding PlaybackFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{x:Static l:Strings.Measure_NoFeedback}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" Margin="0,0,0,16" />
        </Grid>

        <!-- ============ 3 · Ergebnis ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="40,28,40,36" MaxWidth="980" HorizontalAlignment="Left">
                <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" Visibility="{Binding IsLiveResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding ResultsTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ResultsDescription}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,22" />

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WithoutAidBrush}" BorderThickness="1,4,1,1">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Common_WithoutAid}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WithoutAidBrush}" />
                            <TextBlock Text="{Binding WithoutResultText}" FontSize="52" FontWeight="SemiBold" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding WithoutDetailText}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="{StaticResource WithAidBrush}" BorderThickness="1,4,1,1">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Common_WithAid}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" />
                            <TextBlock Text="{Binding WithResultText}" FontSize="52" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding WithDetailText}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{StaticResource WithAidSoftBrush}" CornerRadius="10" Padding="22,16" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DifferenceText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{Binding DifferenceLabel}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource WithAidBrush}" />
                            <TextBlock Text="{Binding ResultExplanationText}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,3,16,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Nächste Schritte -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Content="{Binding AdvanceSeriesButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding AdvanceSeriesCommand}" IsEnabled="{Binding CanAdvanceSeries}" MinWidth="280" MinHeight="44" Margin="0,0,12,0" Visibility="{Binding HasPreparedSeries, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="{x:Static l:Strings.Measure_NewMeasurement}" Command="{Binding NewMeasurementCommand}" MinWidth="200" MinHeight="44" Margin="0,0,12,0" />
                    <Button Content="{x:Static l:Strings.Test_Print}" Command="{Binding PrintResultCommand}" MinWidth="140" MinHeight="44" ToolTip="{x:Static l:Strings.Measure_PrintTooltip}" />
                </StackPanel>
                <TextBlock Text="{Binding SeriesPlanSummary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0" Visibility="{Binding HasPreparedSeries, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Expander Header="{x:Static l:Strings.Measure_Confusions}" Style="{StaticResource HintsExpander}" Visibility="{Binding HasConfusionCells, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="4,10,0,0">
                        <TextBlock Text="{x:Static l:Strings.Measure_ConfusionsIntro}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding ConfusionCells}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" MinHeight="120" MaxHeight="320" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static l:Strings.Measure_ColCondition}" Binding="{Binding Condition, Converter={StaticResource HearingAidConditionLabel}}" Width="1.2*" />
                                <DataGridTextColumn Header="{x:Static l:Strings.Measure_ColPosition}" Binding="{Binding ContrastPosition}" Width="1*" />
                                <DataGridTextColumn Header="{x:Static l:Strings.Measure_ColGroup}" Binding="{Binding ContrastGroupId}" Width="1.1*" />
                                <DataGridTextColumn Header="{x:Static l:Strings.Measure_ColTarget}" Binding="{Binding TargetResponse}" Width="1*" />
                                <DataGridTextColumn Header="{x:Static l:Strings.Measure_ColChoice}" Binding="{Binding SelectedResponse}" Width="1.2*" />
                                <DataGridTextColumn Header="n" Binding="{Binding Count}" Width="50" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
                <Expander Header="{x:Static l:Strings.Measure_ScoringTitle}" Style="{StaticResource HintsExpander}">
                    <TextBlock Margin="4,10,0,0" Text="{x:Static l:Strings.Measure_ScoringText}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</UserControl>
