<UserControl x:Class="HearDelta.App.Views.MeasurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HearDelta.App.Controls">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- ============ 1 · Einrichten ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="40,28,40,36" MaxWidth="860" HorizontalAlignment="Left">
                <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" />
                <TextBlock Text="Worttest" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
                <TextBlock Text="Zwei Blöcke mit je 25 Stimuli – einmal ohne, einmal mit Hörgerät. Reihenfolge und Listen werden zufällig festgelegt." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,20" />

                <!-- Gewählter Schritt des empfohlenen Ablaufs -->
                <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16" Visibility="{Binding HasPlanStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding PlanStepText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Laufende Messreihe -->
                <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16" Visibility="{Binding HasPreparedSeries, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Reihe verwerfen" Style="{StaticResource LinkButton}" Command="{Binding ClearSeriesCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding SeriesPlanSummary}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Was wird getestet -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Material und Umgebung" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Testmaterial" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding MaterialOptions}" SelectedItem="{Binding SelectedMaterialOption}" AutomationProperties.Name="Testmaterial" Margin="0,0,0,14" />
                        <TextBlock Text="Hörumgebung" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding SelectedEnvironment}" AutomationProperties.Name="Hörumgebung" />
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding IsBackgroundNoise, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding SignalToNoiseLabel}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SignalToNoiseRatioDb}" Width="70" HorizontalContentAlignment="Right" AutomationProperties.Name="Signal-Rausch-Abstand in dB" />
                                <TextBlock Text="dB" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsAdaptiveAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Pegel" Style="{StaticResource FieldLabel}" />
                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding LevelModeOptions}" SelectedItem="{Binding SelectedLevelMode}" AutomationProperties.Name="Pegelverfahren" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding LevelModeDescription}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ohr und Hörgerät -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Ohr und Hörgerät" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Geprüftes Ohr" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource EarSegmented}" ItemsSource="{Binding EarOptions}" SelectedItem="{Binding SelectedEar}" AutomationProperties.Name="Geprüftes Ohr" Margin="0,0,0,14" />
                        <TextBlock Text="Hörgerät an diesem Ohr" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding HearingAidChoices}" SelectedItem="{Binding SelectedHearingAidChoice}" DisplayMemberPath="Label" AutomationProperties.Name="Hörgerät" />
                        <TextBlock Text="Gespeicherte Hörgeräte verwaltest du unter „Person wechseln“." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <Grid Margin="0,12,0,0" Visibility="{Binding IsManualHearingAid, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Hersteller" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding HearingAidManufacturer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hersteller" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Modell" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding HearingAidModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Modell" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Bezeichnung im Protokoll" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding HearingAidDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bezeichnung im Protokoll" /></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Programm" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding HearingAidProgramName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Programm" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Name und Kommentar -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Name und Kommentar" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Name der Messung" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Annotation.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Name der Messung" />
                        <TextBlock Text="Vorgabe ist das gewählte Hörgerät. Name und Kommentar lassen sich später im Verlauf ändern." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="Kommentar, Einstellungen (optional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Annotation.Comment, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Kommentar zur Messung" />
                    </StackPanel>
                </Border>

                <!-- Audio -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Audioausgang" Style="{StaticResource SectionHeading}" />
                        <Border Style="{StaticResource WarningBox}" Margin="0,0,0,10" Visibility="{Binding HasNoProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Noch kein Messprofil vorhanden. Lege es unter „Audio und Kopfhörer“ an." Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <TextBlock Text="Messprofil" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Messprofil" />
                        <TextBlock FontSize="13" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding SelectedProfile.EndpointName, Mode=OneWay}" /><Run Text=" · Pegelobergrenze " /><Run Text="{Binding SelectedProfile.MaximumVolumeDb, Mode=OneWay}" /><Run Text=" dB (digital)" />
                        </TextBlock>
                        <TextBlock Text="{Binding PresentationVolumeLabel}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Testwort abspielen" Command="{Binding PlayTestWordCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PresentationVolumeText}" FontWeight="SemiBold" Width="70" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider Minimum="{Binding PresentationVolumeMinimumDb}" Maximum="{Binding PresentationVolumeMaximumDb}" Value="{Binding PresentationVolumeDb, Mode=TwoWay}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" VerticalAlignment="Center" AutomationProperties.Name="Lautstärke der Sprache" />
                        </DockPanel>
                        <TextBlock Text="{Binding LevelSourceText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding HasLevelSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Lautstärke und SNR werden aus den Vortests dieses Ohrs mit demselben Messprofil vorbelegt. Bei jeder Änderung wird ein Testwort auf dem geprüften Ohr abgespielt. Die Lautstärke wird mit der Messung gespeichert; Messungen mit anderer Lautstärke sind nicht direkt vergleichbar (außer beim adaptiven Zahlentest in Ruhe)." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Ablauf -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Ablauf" Style="{StaticResource SectionHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="Ablauf" />
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding IsSeriesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Paare" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SeriesPairCount, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalContentAlignment="Right" AutomationProperties.Name="Anzahl Paare" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Eine Messreihe plant mehrere Paare mit abwechselnder Reihenfolge und getrennten Listen." Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0" Visibility="{Binding IsSeriesMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Button Content="{Binding StartButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding StartMeasurementCommand}" HorizontalAlignment="Left" MinWidth="260" MinHeight="44" />

                <Expander Header="Hinweise zur Messung" Style="{StaticResource HintsExpander}">
                    <StackPanel Margin="4,10,0,0">
                        <TextBlock Text="Der gespeicherte Audioausgang muss verfügbar sein; es gibt keinen Wechsel auf das Windows-Standardgerät. Pegel sind digitale Absenkungen, keine dB SPL. Die Messung ist keine klinische Bewertung." Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ChanceLevelText}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AiVoiceDisclosure}" Margin="0,0,0,12" />
                        <TextBlock Text="Bisherige Darbietungen je Stimulus" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding ExposureCells}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="220" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ebene" Binding="{Binding Scope}" Width="*" />
                                <DataGridTextColumn Header="ID" Binding="{Binding Key}" Width="1.6*" />
                                <DataGridTextColumn Header="Darbietungen" Binding="{Binding PresentationCount}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Gezählt werden nur tatsächlich präsentierte Stimuli. Die Anzeige ist ein Wiederholungsindikator, keine Bewertung." Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 2a · Block vorbereiten ============ -->
        <Grid Visibility="{Binding IsPreparation, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource TestBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Test abbrechen" Command="{Binding AbortMeasurementCommand}" />
                    <controls:StepIndicator DockPanel.Dock="Right" Step="{Binding StepNumber}" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding EarLabel}" /></Border>
                        <TextBlock Text="{Binding CurrentMaterialLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="60,44" MaxWidth="720" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding BlockTitle}" Style="{StaticResource PageTitle}" FontSize="30" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Tag="{Binding CurrentConditionTone}" HorizontalAlignment="Center" Padding="16,6" Margin="0,14,0,0">
                        <TextBlock Text="{Binding CurrentConditionLabel}" FontSize="18" />
                    </Border>
                    <TextBlock Text="{Binding PreparationInstruction}" FontSize="19" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,28" />
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Vor dem Start bestätigen" Style="{StaticResource SectionHeading}" />
                            <CheckBox Content="Die angezeigte Hörseite und der Kopfhörerkanal stimmen." IsChecked="{Binding CorrectEarConfirmed}" Margin="0,0,0,14" />
                            <CheckBox Content="Der Kopfhörer sitzt ohne Kontakt oder Rückkopplung am Hörgerät." IsChecked="{Binding HeadphoneFitConfirmed}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Jeder der 25 Stimuli wird genau einmal abgespielt." TextAlignment="Center" Style="{StaticResource Caption}" FontSize="14" Margin="0,18,0,16" />
                    <Button Content="Block starten" Style="{StaticResource PrimaryButton}" Command="{Binding StartBlockCommand}" IsEnabled="{Binding CanStartBlock}" MinWidth="260" MinHeight="46" HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 2b · Aktiver Test ============ -->
        <Grid Visibility="{Binding IsActiveTest, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource TestBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Test abbrechen" Command="{Binding AbortMeasurementCommand}" />
                    <Button DockPanel.Dock="Right" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding CanPause}" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Tag="{Binding EarTone}" Margin="0,0,8,0"><TextBlock Text="{Binding EarLabel}" /></Border>
                        <Border Style="{StaticResource Badge}" Tag="{Binding CurrentConditionTone}" Margin="0,0,8,0"><TextBlock Text="{Binding CurrentConditionLabel}" /></Border>
                        <TextBlock Text="{Binding CurrentMaterialLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" BorderThickness="0" Background="{StaticResource BorderBrush}" Foreground="{StaticResource AccentBrush}" />
            <StackPanel Grid.Row="2" VerticalAlignment="Center" MaxWidth="980" Margin="40,0">
                <TextBlock Text="Was haben Sie gehört?" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,28" />
                <ItemsControl ItemsSource="{Binding ResponseAlternatives}" IsEnabled="{Binding CanAnswer}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding UsesFreeNumericResponse}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}" Style="{StaticResource AnswerButton}"
                                    Command="{Binding DataContext.SelectAnswerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding UsesFreeNumericResponse, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" Width="360">
                    <TextBlock Text="Dreistellige Zahl eingeben" FontSize="18" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <TextBox x:Name="NumericAnswerTextBox"
                             Text="{Binding NumericAnswer, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanAnswer}"
                             FontSize="34"
                             FontWeight="SemiBold"
                             HorizontalContentAlignment="Center"
                             MaxLength="3"
                             BorderBrush="{StaticResource AccentBrush}"
                             BorderThickness="2"
                             Loaded="NumericAnswerTextBox_OnLoaded"
                             IsEnabledChanged="NumericAnswerTextBox_OnStateChanged"
                             IsVisibleChanged="NumericAnswerTextBox_OnStateChanged" />
                    <Button Content="Antwort speichern"
                            Command="{Binding SubmitNumericAnswerCommand}"
                            IsEnabled="{Binding CanSubmitNumericAnswer}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="46"
                            Margin="0,14,0,0" />
                </StackPanel>
                <Button Content="Nicht verstanden" Command="{Binding NotUnderstoodCommand}" IsEnabled="{Binding CanAnswer}" Margin="7,20,7,0" MinWidth="260" MinHeight="46" FontSize="17" HorizontalAlignment="Center" />
                <Button Content="Wiedergabe erneut versuchen" Command="{Binding RetryPlaybackCommand}" Style="{StaticResource PrimaryButton}" Margin="7,16,7,0" MinWidth="280" HorizontalAlignment="Center" Visibility="{Binding PlaybackFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Keine Rückmeldung zu richtig oder falsch während der Messung." Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" Margin="0,0,0,16" />
        </Grid>

        <!-- ============ 3 · Ergebnis ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="40,28,40,36" MaxWidth="980" HorizontalAlignment="Left">
                <controls:StepIndicator Step="{Binding StepNumber}" Margin="0,0,0,16" Visibility="{Binding IsLiveResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding ResultsTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ResultsDescription}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,22" />

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WithoutAidBrush}" BorderThickness="1,4,1,1">
                        <StackPanel>
                            <TextBlock Text="Ohne Hörgerät" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WithoutAidBrush}" />
                            <TextBlock Text="{Binding WithoutResultText}" FontSize="52" FontWeight="SemiBold" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding WithoutDetailText}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="{StaticResource WithAidBrush}" BorderThickness="1,4,1,1">
                        <StackPanel>
                            <TextBlock Text="Mit Hörgerät" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" />
                            <TextBlock Text="{Binding WithResultText}" FontSize="52" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding WithDetailText}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{StaticResource WithAidSoftBrush}" CornerRadius="10" Padding="22,16" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DifferenceText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WithAidBrush}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{Binding DifferenceLabel}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource WithAidBrush}" />
                            <TextBlock Text="{Binding ResultExplanationText}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,3,16,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Nächste Schritte -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Content="{Binding AdvanceSeriesButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding AdvanceSeriesCommand}" IsEnabled="{Binding CanAdvanceSeries}" MinWidth="280" MinHeight="44" Margin="0,0,12,0" Visibility="{Binding HasPreparedSeries, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Neue Messung" Command="{Binding NewMeasurementCommand}" MinWidth="200" MinHeight="44" Margin="0,0,12,0" />
                    <Button Content="Drucken …" Command="{Binding PrintResultCommand}" MinWidth="140" MinHeight="44" ToolTip="Ergebnis drucken oder als PDF speichern" />
                </StackPanel>
                <TextBlock Text="{Binding SeriesPlanSummary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0" Visibility="{Binding HasPreparedSeries, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Expander Header="Verwechslungen im Phonemtest" Style="{StaticResource HintsExpander}" Visibility="{Binding HasConfusionCells, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="4,10,0,0">
                        <TextBlock Text="Fallzahlen je Ziel und Auswahl. Eine Beschreibung der Antworten, keine Frequenzdiagnose oder Verstärkungsempfehlung." Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding ConfusionCells}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" MinHeight="120" MaxHeight="320" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bedingung" Binding="{Binding Condition}" Width="1.2*" />
                                <DataGridTextColumn Header="Position" Binding="{Binding ContrastPosition}" Width="1*" />
                                <DataGridTextColumn Header="Gruppe" Binding="{Binding ContrastGroupId}" Width="1.1*" />
                                <DataGridTextColumn Header="Ziel" Binding="{Binding TargetResponse}" Width="1*" />
                                <DataGridTextColumn Header="Auswahl" Binding="{Binding SelectedResponse}" Width="1.2*" />
                                <DataGridTextColumn Header="n" Binding="{Binding Count}" Width="50" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
                <Expander Header="Wie wird gewertet?" Style="{StaticResource HintsExpander}">
                    <TextBlock Margin="4,10,0,0" Text="Der Prozentwert ist richtig beantwortet geteilt durch 25. „Nicht verstanden“ zählt als nicht richtig. Rohantworten, Reihenfolge und Wiedergabenachweise bleiben in der lokalen Messung erhalten. Keine klinische Bewertung." />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</UserControl>
