<UserControl x:Class="HearDelta.App.Views.PersonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HearDelta.App.Views">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <views:PersonListView DataContext="{Binding List}" />
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding List}">
            <StackPanel Margin="40,32" MaxWidth="640" HorizontalAlignment="Left">

                <!-- Ausgewählte Person -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsSummaryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0">
                                <TextBlock Text="{Binding SelectedPerson.DisplayName, Converter={StaticResource Initials}}" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPerson.DisplayName}" Style="{StaticResource PageTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedPerson.DateOfBirth, StringFormat='Geboren {0:dd.MM.yyyy}', TargetNullValue='Kein Geburtsdatum hinterlegt'}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedPerson.Notes}" Margin="0,0,0,18" FontSize="15" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Übersicht öffnen" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.ShowOverviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,0" />
                            <Button Content="Bearbeiten" Command="{Binding EditPersonCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hörgeräte der Person -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsSummaryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Hörgeräte" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Gespeicherte Geräte stehen beim Einrichten eines Tests zur Auswahl. Änderungen und Löschen wirken nur auf künftige Messungen." Style="{StaticResource Caption}" FontSize="13" Margin="0,-4,0,12" />
                        <ItemsControl ItemsSource="{Binding HearingAids}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Bearbeiten" Style="{StaticResource LinkButton}" FontSize="13" Margin="0,0,14,0"
                                                        Command="{Binding DataContext.EditHearingAidCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Aid.DisplayName, StringFormat='{}{0} bearbeiten'}" />
                                                <Button Content="Löschen" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" FontSize="13"
                                                        Command="{Binding DataContext.ArchiveHearingAidCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Aid.DisplayName, StringFormat='{}{0} löschen'}" />
                                            </StackPanel>
                                            <Border Style="{StaticResource EarDot}" Tag="{Binding EarTone}" Margin="0,0,10,0"><TextBlock Text="{Binding EarLetter}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Aid.DisplayName}" FontSize="15" />
                                                <TextBlock Style="{StaticResource Caption}" FontSize="12">
                                                    <Run Text="{Binding Aid.Manufacturer, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Aid.Model, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding EarText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Noch keine Hörgeräte hinterlegt." Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,8"
                                   Visibility="{Binding HasNoHearingAids, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding HearingAidFormTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Hersteller" Style="{StaticResource Caption}" Margin="0,0,0,3" /><TextBox Text="{Binding NewAidManufacturer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hersteller" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Modell" Style="{StaticResource Caption}" Margin="0,0,0,3" /><TextBox Text="{Binding NewAidModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Modell" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Bezeichnung (optional, sonst „Hersteller Modell“)" Style="{StaticResource Caption}" Margin="0,10,0,3" />
                        <TextBox Text="{Binding NewAidDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bezeichnung des Hörgeräts" />
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Abbrechen" Command="{Binding CancelHearingAidEditCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding IsEditingHearingAid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="{Binding HearingAidSaveButtonText}" Command="{Binding AddHearingAidCommand}" />
                            </StackPanel>
                            <ListBox Style="{StaticResource EarSegmented}" ItemsSource="{Binding EarOptions}" SelectedItem="{Binding NewAidEar}" AutomationProperties.Name="Ohr des Hörgeräts" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Noch keine Auswahl -->
                <StackPanel Visibility="{Binding IsEmptyHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,40,0,0">
                    <TextBlock Text="Wähle links eine Person" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Alle Tests und Messungen gehören zu einer Person. Lege zuerst eine Person an, falls die Liste leer ist." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,8,0,18" />
                    <Button Content="Neue Person anlegen" Style="{StaticResource PrimaryButton}" Command="{Binding NewPersonCommand}" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Formular: neu oder bearbeiten -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionHeading}" Margin="0,0,0,16" />
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" />
                        <TextBlock Text="Geburtsdatum (optional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <DatePicker SelectedDate="{Binding EditDateOfBirth}" AutomationProperties.Name="Geburtsdatum" FontSize="15" MinHeight="38" HorizontalAlignment="Left" Width="220" />
                        <TextBlock Text="Weitere Informationen (optional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding EditOtherInformation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weitere Informationen" MaxLength="2000" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="{Binding SaveButtonText}" Command="{Binding SavePersonCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,10,0" />
                            <Button Content="Abbrechen" Command="{Binding CancelEditCommand}" IsCancel="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" FontSize="13" Margin="2,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
