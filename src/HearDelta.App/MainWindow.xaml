<Window x:Class="HearDelta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HearDelta.App.Views"
        xmlns:l="clr-namespace:HearDelta.App.Localization"
        Title="HearDelta" Height="1000" Width="1440" MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Menüpunkt in der Leiste; Tag = ist diese Seite aktiv -->
        <Style x:Key="RailNavButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RailActiveBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource RailBrush}" Padding="14,18,14,16">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Top" Text="HearDelta" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,18" />

                <!-- Aktuelle Person; Klick öffnet die Personenverwaltung -->
                <Button DockPanel.Dock="Top" Command="{Binding ShowPersonsCommand}" Tag="{Binding IsPersonsVisible}" Style="{StaticResource RailNavButton}"
                        Margin="0,0,0,18" ToolTip="{x:Static l:Strings.Shell_PersonSwitchTooltip}" AutomationProperties.Name="{x:Static l:Strings.Shell_PersonSwitch}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ContextInitials}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="140">
                            <TextBlock Text="{Binding ContextText}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{x:Static l:Strings.Shell_PersonSwitch}" FontSize="12" Foreground="{StaticResource RailTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Top" Command="{Binding ShowOverviewCommand}" Tag="{Binding IsOverviewVisible}" Style="{StaticResource RailNavButton}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailIcon}" Text="&#xE80F;" /><TextBlock Text="{x:Static l:Strings.Shell_Overview}" /></StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static l:Strings.Shell_TestsSection}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RailTextBrush}" Margin="12,16,0,6" Opacity="0.8" />
                <Button DockPanel.Dock="Top" Command="{Binding ShowMeasurementCommand}" Tag="{Binding IsMeasurementVisible}" Style="{StaticResource RailNavButton}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailIcon}" Text="&#xE8BD;" /><TextBlock Text="{x:Static l:Strings.Shell_WordTest}" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Top" Command="{Binding ShowHearingThresholdCommand}" Tag="{Binding IsHearingThresholdVisible}" Style="{StaticResource RailNavButton}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailIcon}" Text="&#xE767;" /><TextBlock Text="{x:Static l:Strings.Shell_HearingThreshold}" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Top" Command="{Binding ShowPracticeCommand}" Tag="{Binding IsPracticeVisible}" Style="{StaticResource RailNavButton}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailIcon}" Text="&#xE7BE;" /><TextBlock Text="{x:Static l:Strings.Shell_Practice}" /></StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static l:Strings.Shell_EvaluationSection}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RailTextBrush}" Margin="12,16,0,6" Opacity="0.8" />
                <Button DockPanel.Dock="Top" Command="{Binding ShowHistoryCommand}" Tag="{Binding IsHistoryVisible}" Style="{StaticResource RailNavButton}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailIcon}" Text="&#xE81C;" /><TextBlock Text="{x:Static l:Strings.Shell_History}" /></StackPanel>
                </Button>

                <!-- Unten: Audioeinrichtung mit Profilstatus, darüber die Oberflächensprache -->
                <Button DockPanel.Dock="Bottom" Command="{Binding OpenSettingsCommand}" Tag="{Binding IsSettingsVisible}" Style="{StaticResource RailNavButton}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailIcon}" Text="&#xE7F6;" /><TextBlock Text="{x:Static l:Strings.Shell_AudioSettings}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="28,4,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#F5B544" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasProfiles}" Value="True"><Setter Property="Fill" Value="#5CC98A" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ProfileStatusText}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource RailTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="150" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Click="OnLanguageButtonClick" Margin="0,0,0,4"
                        ToolTip="{x:Static l:Strings.Shell_LanguageTooltip}" AutomationProperties.Name="{x:Static l:Strings.Shell_LanguageTooltip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RailIcon}" Text="&#xE774;" /><TextBlock Text="{Binding LanguageText}" /></StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding LanguageOptions}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Label}" />
                                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                    <Setter Property="Command" Value="{Binding DataContext.ChangeLanguageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding Preference}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <views:PersonsView DataContext="{Binding Persons}"
                               Visibility="{Binding DataContext.IsPersonsVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:PersonDetailView DataContext="{Binding Persons.Detail}"
                                    Visibility="{Binding DataContext.IsOverviewVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:MeasurementView DataContext="{Binding Measurement}"
                                   Visibility="{Binding DataContext.IsMeasurementVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:PracticeView DataContext="{Binding Practice}"
                                Visibility="{Binding DataContext.IsPracticeVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:HearingThresholdView DataContext="{Binding HearingThreshold}"
                                        Visibility="{Binding DataContext.IsHearingThresholdVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:HistoryView DataContext="{Binding History}"
                               Visibility="{Binding DataContext.IsHistoryVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsSettingsVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
